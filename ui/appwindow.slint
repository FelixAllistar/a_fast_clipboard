import { ScrollView } from "std-widgets.slint";

export struct ClipRow {
    id: int,
    kind: string,
    preview: string,
    subtitle: string,
    pinned: bool,
    has-thumbnail: bool,
    thumbnail: image,
}

component FlatButton inherits Rectangle {
    in property <string> label;
    in property <bool> dark;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> quiet;
    callback clicked();

    height: 26px;
    border-radius: 5px;
    border-width: quiet ? 0px : 1px;
    border-color: primary
        ? #2f6feb
        : danger
        ? (dark ? #6e3036 : #efc3c4)
        : dark
        ? #3b4250
        : #d5dde8;
    background: button-touch.pressed
        ? (primary ? #2459bf : danger ? (dark ? #4f2328 : #f7dddd) : dark ? #2a303b : #e7edf5)
        : button-touch.has-hover
        ? (primary ? #366fea : danger ? (dark ? #3b2025 : #fff1f1) : quiet ? (dark ? #29303a : #eef2f7) : (dark ? #252b35 : #f8fafc))
        : primary ? #2f6feb : quiet ? transparent : (dark ? #1f242d : #ffffff);

    button-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: root.primary
            ? #ffffff
            : root.danger
            ? (root.dark ? #ff9aa2 : #a63035)
            : root.dark
            ? #e5eaf2
            : #253043;
        font-size: 12px;
        font-weight: root.primary ? 700 : 520;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TextField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> dark;
    callback changed(string);
    callback accepted(string);

    height: 30px;
    border-radius: 5px;
    border-width: 1px;
    border-color: input.has-focus ? #2f6feb : (dark ? #3b4250 : #d8e0ea);
    background: input.has-focus ? (dark ? #202632 : #ffffff) : (dark ? #171a20 : #f8fafc);
    forward-focus: input;

    input := TextInput {
        x: 10px;
        y: 0px;
        width: root.width - 20px;
        height: root.height;
        text <=> root.value;
        color: root.dark ? #edf2f7 : #161b24;
        font-size: 12px;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: #2f6feb;
        selection-foreground-color: #ffffff;
        edited => {
            root.changed(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }

    Text {
        visible: root.value == "";
        x: 12px;
        width: root.width - 24px;
        height: root.height;
        text: root.placeholder;
        color: root.dark ? #8792a3 : #7a8495;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ToggleControl inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    in property <bool> dark;
    callback toggled(bool);

    height: 26px;
    border-radius: 5px;
    border-width: 1px;
    border-color: checked ? #2f6feb : (dark ? #3b4250 : #d5dde8);
    background: checked ? (dark ? #1d3354 : #eef5ff) : toggle-touch.has-hover ? (dark ? #252b35 : #f7f9fc) : (dark ? #1f242d : #ffffff);

    toggle-touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 8px;
        spacing: 6px;

        Rectangle {
            width: 13px;
            height: 13px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? #2f6feb : (root.dark ? #596274 : #aeb8c6);
            background: root.checked ? #2f6feb : (root.dark ? #161a20 : #ffffff);
            vertical-stretch: 0;

            Text {
                text: root.checked ? "✓" : "";
                color: #ffffff;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: root.dark ? #d9e0ea : #2e384a;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component NumberStepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <bool> dark;
    callback changed(int);

    height: 26px;
    width: 90px;
    border-radius: 5px;
    border-width: 1px;
    border-color: dark ? #3b4250 : #d5dde8;
    background: dark ? #1f242d : #ffffff;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 3px;

        FlatButton {
            label: "-";
            dark: root.dark;
            quiet: true;
            width: 24px;
            clicked => {
                root.value = max(root.minimum, root.value - 10);
                root.changed(root.value);
            }
        }

        Text {
            text: root.value;
            color: root.dark ? #edf2f7 : #161b24;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        FlatButton {
            label: "+";
            dark: root.dark;
            quiet: true;
            width: 24px;
            clicked => {
                root.value = min(root.maximum, root.value + 10);
                root.changed(root.value);
            }
        }
    }
}

component ClipItem inherits Rectangle {
    in property <ClipRow> entry;
    in property <bool> selected;
    in property <bool> dark;
    callback choose(int);
    callback toggle-pin(int);
    callback remove(int);

    height: 50px;
    border-radius: 5px;
    border-width: 1px;
    border-color: selected ? #3f78d7 : transparent;
    background: selected ? (dark ? #203653 : #edf4ff) : item-touch.has-hover ? (dark ? #222832 : #f7f9fc) : transparent;

    item-touch := TouchArea {
        clicked => {
            root.choose(root.entry.id);
        }
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 7px;

        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: 5px;
            border-width: root.entry.has-thumbnail ? 1px : 0px;
            border-color: root.dark ? #343b48 : #dde4ee;
            background: root.entry.has-thumbnail ? (root.dark ? #111419 : #ffffff) : transparent;
            vertical-stretch: 0;

            Image {
                visible: root.entry.has-thumbnail;
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                source: root.entry.thumbnail;
                image-fit: contain;
            }

            Text {
                visible: !root.entry.has-thumbnail;
                text: root.entry.kind == "image" ? "IMG" : "";
                color: root.dark ? #8792a3 : #738093;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.entry.preview;
                color: root.dark ? #edf2f7 : #172033;
                font-size: 12px;
                font-weight: selected ? 700 : 500;
                overflow: elide;
                wrap: no-wrap;
            }

            Text {
                text: root.entry.subtitle;
                color: root.dark ? #a1aabb : #6d7788;
                font-size: 11px;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        FlatButton {
            label: root.entry.pinned ? "Pinned" : "Pin";
            width: 54px;
            dark: root.dark;
            quiet: !root.entry.pinned && !item-touch.has-hover && !root.selected;
            primary: root.entry.pinned;
            clicked => {
                root.toggle-pin(root.entry.id);
            }
        }

        FlatButton {
            label: "Del";
            width: 40px;
            dark: root.dark;
            quiet: !item-touch.has-hover && !root.selected;
            danger: true;
            clicked => {
                root.remove(root.entry.id);
            }
        }
    }
}

export component AppWindow inherits Window {
    width: 620px;
    height: 392px;
    title: "Fast Clipboard";
    no-frame: true;
    always-on-top: true;

    in property <[ClipRow]> clips;
    in-out property <string> query;
    in-out property <int> selected-index;
    in-out property <int> retention-limit;
    in-out property <string> hotkey-text;
    in-out property <bool> recording-hotkey;
    in-out property <bool> paste-on-select;
    in-out property <bool> start-with-windows;
    in-out property <bool> quit-confirm-visible;
    in-out property <bool> settings-visible;
    in-out property <string> theme-mode;
    in property <bool> dark-mode;
    in property <bool> onboarding-visible;
    in property <string> count-text;
    in property <string> status-text;

    callback search-changed(string);
    callback move-selection(int);
    callback select-index(int);
    callback select-clip(int);
    callback delete-selected();
    callback toggle-selected-pin();
    callback toggle-pin(int);
    callback delete-clip(int);
    callback clear-unpinned();
    callback hotkey-changed(string);
    callback hotkey-recorded(string, bool, bool, bool, bool);
    callback retention-changed(int);
    callback paste-setting-changed(bool);
    callback startup-setting-changed(bool);
    callback theme-setting-changed(string);
    callback hide-requested();
    callback quit-requested();

    background: transparent;
    forward-focus: search;

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (root.recording-hotkey) {
                root.recording-hotkey = false;
                root.hotkey-recorded(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.meta,
                );
                accept
            } else if (root.quit-confirm-visible && event.text == Key.Escape) {
                root.quit-confirm-visible = false;
                accept
            } else if (root.settings-visible && event.text == Key.Escape) {
                root.settings-visible = false;
                accept
            } else if (event.text == Key.Escape) {
                root.hide-requested();
                accept
            } else if (event.text == Key.DownArrow) {
                root.selected-index = root.selected-index + 1;
                root.move-selection(root.selected-index);
                accept
            } else if (event.text == Key.UpArrow) {
                root.selected-index = root.selected-index - 1;
                root.move-selection(root.selected-index);
                accept
            } else {
                reject
            }
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.select-index(root.selected-index);
            }
        }

        KeyBinding {
            keys: @keys(Delete);
            activated => {
                root.delete-selected();
            }
        }

        KeyBinding {
            keys: @keys(Control + P);
            activated => {
                root.toggle-selected-pin();
            }
        }

        KeyBinding {
            keys: @keys(Control + Digit1);
            activated => { root.select-index(0); }
        }

        KeyBinding {
            keys: @keys(Control + Digit2);
            activated => { root.select-index(1); }
        }

        KeyBinding {
            keys: @keys(Control + Digit3);
            activated => { root.select-index(2); }
        }

        KeyBinding {
            keys: @keys(Control + Digit4);
            activated => { root.select-index(3); }
        }

        KeyBinding {
            keys: @keys(Control + Digit5);
            activated => { root.select-index(4); }
        }

        KeyBinding {
            keys: @keys(Control + Digit6);
            activated => { root.select-index(5); }
        }

        KeyBinding {
            keys: @keys(Control + Digit7);
            activated => { root.select-index(6); }
        }

        KeyBinding {
            keys: @keys(Control + Digit8);
            activated => { root.select-index(7); }
        }

        KeyBinding {
            keys: @keys(Control + Digit9);
            activated => { root.select-index(8); }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.dark-mode ? #3a414e : #cfd7e3;
            background: root.dark-mode ? #1d222b : #f5f7fa;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    height: 30px;
                    spacing: 6px;

                    search := TextField {
                        value <=> root.query;
                        dark: root.dark-mode;
                        placeholder: "Search";
                        changed(text) => {
                            root.selected-index = 0;
                            root.search-changed(text);
                        }
                        accepted(text) => {
                            root.select-index(root.selected-index);
                        }
                    }

                    FlatButton {
                        label: "Settings";
                        dark: root.dark-mode;
                        primary: root.settings-visible;
                        width: 64px;
                        clicked => {
                            root.settings-visible = !root.settings-visible;
                            root.quit-confirm-visible = false;
                        }
                    }

                    FlatButton {
                        label: "-";
                        dark: root.dark-mode;
                        quiet: true;
                        width: 30px;
                        clicked => {
                            root.hide-requested();
                        }
                    }

                    FlatButton {
                        label: "×";
                        dark: root.dark-mode;
                        quiet: true;
                        danger: true;
                        width: 30px;
                        clicked => {
                            root.settings-visible = false;
                            root.quit-confirm-visible = true;
                        }
                    }
                }

                Rectangle {
                    visible: root.onboarding-visible;
                    height: root.onboarding-visible ? 28px : 0px;
                    background: root.dark-mode ? #1d3354 : #edf5ff;
                    border-color: root.dark-mode ? #355b8d : #c3d9fa;
                    border-width: 1px;
                    border-radius: 5px;

                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: "Startup is on. Set a hotkey; Hide keeps it in the tray.";
                        color: root.dark-mode ? #d9e8ff : #233552;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: root.onboarding-visible ? 300px : 316px;
                    background: root.dark-mode ? #141820 : #ffffff;
                    border-color: root.dark-mode ? #303744 : #dbe3ee;
                    border-width: 1px;
                    border-radius: 6px;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;

                            for clip[index] in clips: ClipItem {
                                entry: clip;
                                dark: root.dark-mode;
                                selected: index == root.selected-index;
                                choose(id) => {
                                    root.select-clip(id);
                                }
                                toggle-pin(id) => {
                                    root.toggle-pin(id);
                                }
                                remove(id) => {
                                    root.delete-clip(id);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;

                    Text {
                        text: count-text;
                        color: root.dark-mode ? #9ca6b8 : #586477;
                        vertical-alignment: center;
                        font-size: 10px;
                        width: 72px;
                        overflow: elide;
                    }

                    Text {
                        text: status-text;
                        color: root.dark-mode ? #9ca6b8 : #586477;
                        vertical-alignment: center;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                visible: root.settings-visible;
                x: 8px;
                y: parent.height - 152px;
                width: parent.width - 16px;
                height: 144px;
                border-radius: 7px;
                border-width: 1px;
                border-color: root.dark-mode ? #465061 : #cbd5e1;
                background: root.dark-mode ? #202631 : #ffffff;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 26px;
                        spacing: 6px;

                        Text {
                            text: "Theme";
                            color: root.dark-mode ? #d9e0ea : #465267;
                            vertical-alignment: center;
                            font-size: 11px;
                            width: 52px;
                        }

                        FlatButton {
                            label: "System";
                            dark: root.dark-mode;
                            primary: root.theme-mode == "system";
                            width: 64px;
                            clicked => {
                                root.theme-setting-changed("system");
                            }
                        }

                        FlatButton {
                            label: "Dark";
                            dark: root.dark-mode;
                            primary: root.theme-mode == "dark";
                            width: 54px;
                            clicked => {
                                root.theme-setting-changed("dark");
                            }
                        }

                        FlatButton {
                            label: "Light";
                            dark: root.dark-mode;
                            primary: root.theme-mode == "light";
                            width: 54px;
                            clicked => {
                                root.theme-setting-changed("light");
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 26px;
                        spacing: 8px;

                        Text {
                            text: "Keep";
                            color: root.dark-mode ? #d9e0ea : #465267;
                            vertical-alignment: center;
                            font-size: 11px;
                            width: 34px;
                        }

                        NumberStepper {
                            value <=> root.retention-limit;
                            dark: root.dark-mode;
                            minimum: 10;
                            maximum: 10000;
                            changed(value) => {
                                root.retention-changed(value);
                            }
                        }

                        ToggleControl {
                            label: "Paste";
                            dark: root.dark-mode;
                            checked <=> root.paste-on-select;
                            width: 80px;
                            toggled(value) => {
                                root.paste-setting-changed(value);
                            }
                        }

                        ToggleControl {
                            label: "Startup";
                            dark: root.dark-mode;
                            checked <=> root.start-with-windows;
                            width: 88px;
                            toggled(value) => {
                                root.startup-setting-changed(value);
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;

                        Text {
                            text: "Hotkey";
                            color: root.dark-mode ? #d9e0ea : #465267;
                            vertical-alignment: center;
                            font-size: 11px;
                            width: 42px;
                        }

                        TextField {
                            value <=> root.hotkey-text;
                            dark: root.dark-mode;
                            placeholder: "Ctrl+Alt+V";
                            width: 132px;
                            accepted(text) => {
                                root.hotkey-changed(text);
                            }
                        }

                        FlatButton {
                            label: root.recording-hotkey ? "..." : "Rec";
                            dark: root.dark-mode;
                            width: 38px;
                            primary: root.recording-hotkey;
                            clicked => {
                                root.recording-hotkey = true;
                            }
                        }

                        FlatButton {
                            label: "Clear unpinned";
                            dark: root.dark-mode;
                            danger: true;
                            width: 108px;
                            clicked => {
                                root.clear-unpinned();
                            }
                        }
                    }
                }
            }

            Rectangle {
                visible: root.quit-confirm-visible;
                x: 122px;
                y: 138px;
                width: parent.width - 244px;
                height: 108px;
                border-radius: 7px;
                border-width: 1px;
                border-color: root.dark-mode ? #465061 : #c7d2e1;
                background: root.dark-mode ? #202631 : #ffffff;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    Text {
                        text: "Fully close Fast Clipboard?";
                        color: root.dark-mode ? #edf2f7 : #182235;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "History stays saved. Clipboard capture stops.";
                        color: root.dark-mode ? #a1aabb : #667386;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;

                        FlatButton {
                            label: "Cancel";
                            dark: root.dark-mode;
                            clicked => {
                                root.quit-confirm-visible = false;
                            }
                        }

                        FlatButton {
                            label: "Quit";
                            dark: root.dark-mode;
                            danger: true;
                            clicked => {
                                root.quit-confirm-visible = false;
                                root.quit-requested();
                            }
                        }
                    }
                }
            }
        }
    }
}
